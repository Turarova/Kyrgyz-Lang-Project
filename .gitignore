# Этот файл .gitignore должен лежать в корневой папке проекта Unity (рядом с папками Assets и ProjectSettings)

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Папка кэша памяти
/[Mm]emoryCaptures/

# Папки с записями (Recorder)
/[Rr]ecordings/

# Папка Asset Store (скачанные ассеты можно перекачать из Package Manager, но если используете кастомные, эту строку можно удалить)
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*

# Временные файлы Visual Studio / Rider / VS Code
/.vs/
/.idea/
/.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Файлы логов и сборок Unity3D
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app

# Сгенерированные файлы Crashlytics
crashlytics-build.properties

# Системные файлы macOS и Windows
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db